      { "tiles": [71, 75, 77, 79], "count": [1, 4], "radius": [1, 2], "density": 0.6 },
      { "tiles": [5, 6, 7, 8, 9, 1], "count": [1, 5], "radius": [1, 3], "density": 0.5 }
    ],
    "lines": [
      { "tiles": [12], "count": [0, 3], "length": [5, 25], "width": [1, 3] },
      { "tiles": [10], "count": [0, 2], "length": [3, 12], "width": [1, 1] }
