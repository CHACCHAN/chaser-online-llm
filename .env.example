# 自動生成: bun scripts/gen-env-example.ts（項目の追加・既定値の変更は src/settings.ts で行う）

# ===== CHaserOnline サーバ・試合 =====
# CHaserOnline ユーザ接続ベースURL
HOST_URL=http://www7019ug.sakura.ne.jp/CHaserOnline003/user/
# CHaserOnline ログインユーザ名
CHASER_USER=
# CHaserOnline ログインパスワード
CHASER_PASS=
# デフォルトのルーム番号
CHASER_ROOM=3
# Webマップ明示指定URL（空欄で MapView.jsp を自動探索）
CHASER_WEB_MAP_URL=
# Webマップの取り直し: every_turn（毎ターン）| warp（ワープ時のみ）| off
CHASER_WEB_MAP_REFRESH=every_turn
# Webマップがまだ取れていない時に再挑戦する間隔（ターン）。サーバが重い時や複数人で開始待ちの時用
CHASER_WEB_MAP_RETRY_TURNS=5
# Webマップ取得の通信1回あたりのタイムアウト（秒）。取得は裏で行うので試合は待たない
CHASER_WEB_MAP_TIMEOUT_SEC=10
# ワープを踏んだ直後（着地先のまわりが分からない）、次の手を決める前に Webマップでの位置合わせを待つ上限（秒）。0=待たない
CHASER_WARP_ALIGN_WAIT_SEC=5
# CHaser サーバへの通信1回あたりのタイムアウト（秒、0=無制限）。サーバが応答しないまま試合が止まり続けるのを防ぐ（他プレイヤー待ちは別の仕組みなので影響しない）
CHASER_HTTP_TIMEOUT_SEC=180
# 1試合の最大ターン数（空=サーバが終えるまで）
CHASER_MAX_TURNS=
# 連続モードの最大試合数（空=無制限）
CHASER_MAX_MATCHES=
# コマンド再送間隔（ミリ秒、50以上）
CHASER_RETRY_MS=250
# 入室後・各コマンド後に他プレイヤーを待つ上限（分、0=無制限）。複数人ルームでは相手の思考時間ぶん待たされる
CHASER_PLAYER_WAIT_MIN=30
# 二重ログイン拒否時にログインを再試行し続ける時間（分）
CHASER_LOGIN_WAIT_MIN=10
# ログイン再試行の間隔（秒）
CHASER_LOGIN_RETRY_SEC=45

# ===== Claude Code ハーネス / エージェント =====
# LLM のつなぎ方: api（Anthropic 互換の API。LLM_API_URL・LLM_API_KEY・LLM_API_HEADERS）| subscription（Claude のサブスクリプション。LLM_OAUTH_TOKEN）
LLM_AUTH_MODE=api
# api: Anthropic 互換 API の URL（/v1/messages を持つもの。末尾の /v1 は有っても無くてもよい。空なら Anthropic API に直接）
LLM_API_URL=
# api: API キー（LLM_API_HEADERS の {KEY} に入る。鍵の無いローカル LLM なら空でよい）
LLM_API_KEY=
# api: 送るヘッダ（"名前: 値; 名前: 値"。{KEY} は LLM_API_KEY に置き換わる）。例: Anthropic 直接 "x-api-key: {KEY}" / LiteLLM 等 "Authorization: Bearer {KEY}" / Gravitee "x-api-key: {KEY}; X-Gravitee-Api-Key: {KEY}"
LLM_API_HEADERS=x-api-key: {KEY}
# subscription: `claude setup-token` で作ったトークン（空なら `bun run claude-login` でログインした情報を使う）
LLM_OAUTH_TOKEN=
# モデルのコンテキストの大きさ（トークン。例 32768・128k）。自動コンパクトはこれを上限として会話を要約する（CLAUDE_CODE_AUTO_COMPACT_WINDOW）。空なら Claude Code の既定（知っているモデルはその大きさ、知らないモデルは Claude Code が仮定する大きさ）。ローカル LLM など小さいモデルで設定する
LLM_CONTEXT_WINDOW=
# 会話がコンテキストに近づいたら自動で要約する（Claude Code の自動コンパクト。準備・サブ・振り返りの長い会話に効く。試合中のメインは毎フェーズ新しい会話なので関係しない）
LLM_AUTO_COMPACT=true
# 自動コンパクトを始める使用率（%、1〜100。空なら Claude Code の既定。CLAUDE_AUTOCOMPACT_PCT_OVERRIDE）
LLM_AUTO_COMPACT_PCT=
# 1回の応答の最大トークン（空なら Claude Code の既定。CLAUDE_CODE_MAX_OUTPUT_TOKENS）。出力の上限が小さいモデルで設定する
LLM_MAX_OUTPUT_TOKENS=
# メインエージェントのモデル（api はゲートウェイの /models から、subscription は opus / sonnet / haiku など）
LLM_MODEL_NAME=
# サブエージェントのモデル（空ならメインと同じ）
LLM_SUB_MODEL_NAME=
# メインの effort: low | medium | high | xhigh | max
LLM_MODEL_EFFORT=medium
# サブの effort（空ならメインと同じ）
LLM_SUB_MODEL_EFFORT=
# 使う作戦方針の名前（agent/policies/<名前>.md。WebUI の設定から編集・切替できる）
AGENT_POLICY=default
# メインエージェントを使う（false でソルバーのみ）
AGENT_USE_MAIN=true
# メインがこの秒数たっても返答しない時、同じ問い合わせをもう1つのプロセスにも送り、先に返った方を使う（ゲートウェイの詰まり対策。0=しない）
AGENT_HEDGE_SEC=15
# メインの1フェーズあたりの思考予算（秒、3以上）。超えたらソルバー手を送信
AGENT_TURN_BUDGET_SEC=20
# 試合前の準備フェーズ（true/false）。入室前にメインがツール（読むだけ）でルール・ルームの過去の試合・作戦方針を調べ、最初のメモを作る
AGENT_PREP=true
# 準備フェーズの上限（秒）。超えたらメモなしで試合を始める
AGENT_PREP_TIMEOUT_SEC=180
# 連続モードで次の試合の準備に失敗した時（LLM の利用制限・ゲートウェイの停止など）、この分だけ待って準備をやり直す（0=やり直さず止まる）
AGENT_PREP_RETRY_MIN=5
# 準備フェーズで読ませる、このルームの過去の試合の数（新しい順）
AGENT_PREP_PAST_RUNS=5
# メインが次のフェーズへ引き継ぐメモの上限（字）。メインは毎フェーズ前の会話なしで呼ばれ、メモ・直近の経過・現在の状況だけを受け取る
AGENT_MEMO_MAX_CHARS=2000
# 試合中のメインに見せる「既知のワープ・マスのメモ」の範囲（今の位置からのマス数）
AGENT_KNOWN_CELLS_RADIUS=12
# メインに渡す「直近の経過」のフェーズ数
AGENT_RECENT_PHASES=20
# メインに毎回渡す「サブへの依頼（TODO）」の件数（新しい順）
AGENT_SUB_TODO_ITEMS=10
# 同時に動かすサブの数（依頼ごとに別のセッション）。超えた依頼は待機し、空いたら順に始める
AGENT_SUB_CONCURRENCY=5
# サブの1仕事あたりの上限（分）
AGENT_SUB_TASK_TIMEOUT_MIN=10
# 試合後の振り返り・ソルバー改修の上限（分）
AGENT_POST_MATCH_TIMEOUT_MIN=15
# 1試合で使うトークンの上限（メイン・サブの合計。キャッシュ分も含む。0=無制限）。超えたら残りはソルバーのみで続ける
AGENT_MATCH_TOKEN_LIMIT=20000000
# 試合後の振り返りのあと、エージェントにハーネスの使い勝手・不具合・欲しい機能をレビューさせ agent/REVIEW.md に書く（true/false）
AGENT_REVIEW=true
# ハーネスのレビューの上限（秒）
AGENT_REVIEW_TIMEOUT_SEC=240
# agent/REVIEW.md に残すレビューの件数（新しい順）
AGENT_REVIEW_KEEP=30
# このターン数未満で終わった試合（待機切れ・接続失敗など）は振り返り・最高記録の更新をしない
AGENT_EVOLVE_MIN_TURNS=3
# WebUI 連続モードで試合後にソルバー改修（振り返り）を行う（bun run play は --evolve 指定時のみ）
AGENT_EVOLVE=true
# ゲートウェイ /models 取得のタイムアウト（秒）
LLM_MODELS_TIMEOUT_SEC=10

# ===== その他 =====
# WebUI のポート
PORT=3456
